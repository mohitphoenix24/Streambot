# Copy this file to `.env` (repo root) and fill in the values.
# `.env` is git-ignored. NEVER commit a real key.

# ── OpenAI (required) ────────────────────────────
OPENAI_API_KEY=your_key
# The model is configuration, not code. Put the exact model id you have access
# to. This app deliberately has no default so it never silently picks a model
# (or a price) for you.
OPENAI_MODEL=gpt-5.6-luna
# Optional cheaper model used only for generating conversation titles.
# If empty, OPENAI_MODEL is used. (Model routing: cheap model -> title,
# strong model -> answer.) If you set this, add it to AI/data/prices.toml too.
# Already priced in prices.toml: gpt-5.4-mini, gpt-5.6-luna.
OPENAI_TITLE_MODEL=
# Seconds to wait on the connection / between streamed chunks before giving up.
OPENAI_TIMEOUT_S=60

# ── Generation limits ────────────────────────────────────────────────────
# Hard cap on tokens the model may generate per reply (cost + latency guard).
# If the model hits it, the UI tells the user the answer was cut off.
MAX_OUTPUT_TOKENS=1024

# ── History budget (see AI/app/chat/history.py) ────────
# NOT the model's context window. A deliberately smaller budget for past
# messages so there is always room for instructions + new input + the reply.
HISTORY_BUDGET_TOKENS=6000

# ── Memory (long conversations) ──────────────────────────────────────────
# When a chat outgrows HISTORY_BUDGET_TOKENS, the oldest messages are folded into a
# running summary (a background call after each reply) instead of being forgotten.
MEMORY_SUMMARY_ENABLED=true
# Model that writes the summaries. Empty = the title model (so a cheap model is used).
# If you set this, add it to AI/data/prices.toml too.
OPENAI_SUMMARY_MODEL=

# ── Display ──────────────────────────────────────────────────────────────
# OpenAI bills in USD. The UI also shows an INR equivalent beside every USD cost.
#   auto     fetch the current USD->INR market rate (free public API, cached 6 h)
#   <number> use exactly this rate, e.g. 96.4
#   0        hide INR
# It's a display conversion of the stored USD cost, not what your card will charge.
USD_TO_INR=auto
# Used only if the live lookup has never worked (INR per 1 USD).
USD_TO_INR_FALLBACK=96

# ── Abuse / cost protection ──────────────────────────────────────────────
MAX_MESSAGE_CHARS=8000
# Max chat requests per client IP per minute. 0 disables.
RATE_LIMIT_PER_MINUTE=20

# ── Reliability ──────────────────────────────────────────────────────────
# Total attempts for ONE reply, counting the first. Retries only ever happen
# BEFORE the first token reaches the user. 1 = never retry.
LLM_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_S=0.5
# How often the partial assistant text is flushed to SQLite while streaming.
PARTIAL_FLUSH_INTERVAL_S=1.0

# ── Storage / pricing / web ──────────────────────────────────────────────
# PostgreSQL (with pgvector). `docker compose up -d postgres` starts it; ./run.sh does that for you.
DATABASE_URL=postgresql://streambot:streambot@localhost:5440/streambot
# Max connections kept open to the database.
DB_POOL_MAX=10
# Relative paths resolve against the AI/ directory.
PRICES_PATH=data/prices.toml
# Leave empty in development: any http://localhost:<port> may call the API.
# In production list your exact frontend origin(s), comma separated.
CORS_ORIGINS=
LOG_LEVEL=INFO

# ── Web search (agent mode) ──────────────────────────────────────────────
# With a Tavily key the model can search the web and cite its sources; the UI has a
# toggle to turn it off per message. Leave the key empty to disable the tool.
TAVILY_API_KEY=
# Results the model gets per search.
WEB_SEARCH_MAX_RESULTS=5
